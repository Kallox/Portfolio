---
interface Props {
    alt: string;
    href: string;
    icon: string;
    label: string;
}

const { alt, href, icon, label } = Astro.props;
---

<a
    class="flex items-center justify-center h-10 border rounded-lg p-4 gap-2 text-sm transition-all duration-300 hover:border-purple-700"
    href={href}
    target="_blank"><img src={icon} alt={alt} class="h-4" /> {label}</a
>
