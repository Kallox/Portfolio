---
interface Props {
    title: string;
    img: string;
    description: string;
}

const { description, title, img } = Astro.props;
---

<li
    class="list-none p-4 bg-[#0c091f] backdrop-blur shadow-lg rounded-xl border-2 border-primary"
>
    <div class="flex flex-col items-center text-center gap-3">
        <img
            src={img}
            alt={title}
            class="mt-2 mb-0 h-12 w-12 bg-primary/20 rounded-lg p-1"
        />
        <h3 class="font-semiboldr">
            {title}
        </h3>
        <p class="text-sm text-muted-foreground">{description}</p>
    </div>
</li>
