---
interface Props {
    role: string;
    company: string;
    startDate: string;
    endDate: string;
}

const { role, company, startDate, endDate } = Astro.props;
---

<div class="bg-card shadow-lg rounded-xl p-4 border border-border card-hover" data-animate>
    <div class="flex flex-col mb-2">
        <div class="flex flex-col md:flex-row gap-1 justify-between mb-2">
            <h3 class="text-2xl font-bold text-primary">{company}</h3>
            <span
                class="text-xs text-primary-foreground bg-background/50 px-2 py-2 rounded-lg"
                >{startDate} - {endDate}</span
            >
        </div>
        <span class="text-md text-muted-foreground">{role}</span>
    </div>
    <slot />
</div>
